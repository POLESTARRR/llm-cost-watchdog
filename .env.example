# --- Provider credentials -------------------------------------------------
# Set only the ones you actually use. The watchdog tracks whichever providers
# are configured; a missing key disables that provider, it doesn't break the
# tracker. Check status with the `list_providers` MCP tool.

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Anthropic Claude — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Watchdog config ------------------------------------------------------
# Weekly spend budget in USD, used by check_budget_status() and the digest.
WEEKLY_BUDGET_USD=5.00

# Retries on rate-limit (429) errors before giving up. Backoff is exponential
# with jitter. Set 0 to disable retrying.
LLM_MAX_RETRIES=3

# Override where the SQLite DB lives (defaults to ./data/usage.db).
# WATCHDOG_DB_PATH=/absolute/path/to/usage.db
