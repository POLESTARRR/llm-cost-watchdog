# --- Provider credentials -------------------------------------------------
# Set only the ones you actually use. The watchdog tracks whichever providers
# are configured; a missing key disables that provider, it doesn't break the
# tracker. Check status with the `list_providers` MCP tool.

# Google Gemini, https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Anthropic Claude, https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI, https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Watchdog config ------------------------------------------------------
# Weekly spend budget in USD, used by check_budget_status() and the digest.
WEEKLY_BUDGET_USD=5.00
# Note: if you also import Claude Code build-time cost (see
# scripts/import_claude_code_usage.py, README SS8d), a real build session can
# easily run $50-150 in Anthropic tokens, raise this accordingly, or the
# budget tile will permanently read "over" against a limit that was never
# meant to cover build cost in the first place.

# Retries on rate-limit (429) errors before giving up. Backoff is exponential
# with jitter. Set 0 to disable retrying.
LLM_MAX_RETRIES=3

# If the requested provider is rate-limited and another provider has
# credentials, fall over to it instead of failing the call. Set to `off` to
# disable and let 429s propagate.
WATCHDOG_FALLBACK=on

# --- Spend guardrails -----------------------------------------------------
# The one part of this project that STOPS spend rather than reporting it.
#   off   - nothing is checked
#   warn  - over-limit calls are logged but still sent  (default)
#   block - over-limit calls raise BudgetExceededError and are never sent
WATCHDOG_GUARD_MODE=warn

# Trip the circuit breaker above this many calls per minute. This is the
# runaway-agent-loop guard, call rate spikes long before cost does on cheap
# models. Set 0 to disable.
WATCHDOG_MAX_CALLS_PER_MIN=60

# Refuse a single call whose estimated cost exceeds this. Set 0 to disable.
WATCHDOG_MAX_COST_PER_CALL=1.00

# Optional per-project spend caps, comma separated.
# WATCHDOG_PROJECT_CAPS=job-search-agent:2.00,teaching-workshop:1.00

# Override where the SQLite DB lives (defaults to ./data/usage.db).
# WATCHDOG_DB_PATH=/absolute/path/to/usage.db

# ---------------------------------------------------------------------------
# Local models (Ollama) - the zero-cost routing tier
# ---------------------------------------------------------------------------
# No API key: the "credential" is a running server. Start one with `ollama serve`
# and pull a model with e.g. `ollama pull llama3.2:3b`.
# Model ids are namespaced (`ollama/llama3.2:3b`) so a locally-served `gemma`
# can't be confused with Google's.
OLLAMA_HOST=http://localhost:11434
# Local generation is slow but free; a hosted-API timeout would abort healthy calls.
OLLAMA_TIMEOUT_S=300

# ---------------------------------------------------------------------------
# Gateway - the OpenAI-compatible proxy (src/gateway.py)
# ---------------------------------------------------------------------------
# Point any OpenAI-SDK app at the dashboard and it becomes tracked, routed and
# budget-enforced with no code change:
#     OPENAI_BASE_URL=http://localhost:8000/v1
#     OPENAI_API_KEY=wd-<project-name>
# The key's `wd-` suffix becomes the ledger's project_tag, which is what makes
# per-project caps work for gateway traffic.
#
# Shared secret. UNSET MEANS OPEN TO ANY CALLER THAT CAN REACH THE PORT, which
# is fine on localhost and unsafe anywhere else.
# WATCHDOG_GATEWAY_KEY=
# project_tag used when a caller sends no wd-* key.
WATCHDOG_GATEWAY_PROJECT=gateway

# ---------------------------------------------------------------------------
# Complexity routing (src/complexity.py)
# ---------------------------------------------------------------------------
# The one strategy that reads the prompt instead of the ledger. Group members
# are ordered by price and the classified tier indexes into that ladder, so a
# group should be listed cheapest-capable first.
# WATCHDOG_ROUTING_STRATEGY=complexity
# WATCHDOG_GROUP_LADDER=ollama/llama3.2:3b,gemini-flash-lite-latest,gemini-pro-latest

# ---------------------------------------------------------------------------
# Shadow comparison (src/shadow.py) - measuring whether cheap was good enough
# ---------------------------------------------------------------------------
# Fraction of gateway calls to ALSO run against a local model, storing both
# answers for later grading. 0 disables it entirely (the default).
# NOTE: shadow rows store FULL PROMPT TEXT, the one place this project does.
# They live in their own table and `purge_shadows()` deletes them.
WATCHDOG_SHADOW_RATE=0
WATCHDOG_SHADOW_MODEL=ollama/llama3.2:3b
WATCHDOG_SHADOW_MAX_CHARS=8000

# Grading model for shadow comparisons (src/judge.py). Local by default so a
# week of grading costs nothing. Point it at a stronger model and the same
# pipeline produces stronger evidence with no other change.
WATCHDOG_JUDGE_MODEL=ollama/llama3.2:3b
