# --- Provider credentials -------------------------------------------------
# Set only the ones you actually use. The watchdog tracks whichever providers
# are configured; a missing key disables that provider, it doesn't break the
# tracker. Check status with the `list_providers` MCP tool.

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Anthropic Claude — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Watchdog config ------------------------------------------------------
# Weekly spend budget in USD, used by check_budget_status() and the digest.
WEEKLY_BUDGET_USD=5.00

# Retries on rate-limit (429) errors before giving up. Backoff is exponential
# with jitter. Set 0 to disable retrying.
LLM_MAX_RETRIES=3

# If the requested provider is rate-limited and another provider has
# credentials, fall over to it instead of failing the call. Set to `off` to
# disable and let 429s propagate.
WATCHDOG_FALLBACK=on

# --- Spend guardrails -----------------------------------------------------
# The one part of this project that STOPS spend rather than reporting it.
#   off   - nothing is checked
#   warn  - over-limit calls are logged but still sent  (default)
#   block - over-limit calls raise BudgetExceededError and are never sent
WATCHDOG_GUARD_MODE=warn

# Trip the circuit breaker above this many calls per minute. This is the
# runaway-agent-loop guard -- call rate spikes long before cost does on cheap
# models. Set 0 to disable.
WATCHDOG_MAX_CALLS_PER_MIN=60

# Refuse a single call whose estimated cost exceeds this. Set 0 to disable.
WATCHDOG_MAX_COST_PER_CALL=1.00

# Optional per-project spend caps, comma separated.
# WATCHDOG_PROJECT_CAPS=job-search-agent:2.00,teaching-workshop:1.00

# Override where the SQLite DB lives (defaults to ./data/usage.db).
# WATCHDOG_DB_PATH=/absolute/path/to/usage.db
