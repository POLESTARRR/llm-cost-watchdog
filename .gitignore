.env
.env.render
venv/
__pycache__/
*.pyc
data/usage.db
data/reports/
# Cached copy of LiteLLM's public price map, refetched on demand by
# src/pricing_drift.py. ~1.7MB of third-party data with its own release
# cadence — vendoring it would just go stale in the history.
data/litellm_price_map.json
.pytest_cache/
*.egg-info/
.DS_Store

# Runtime log from the scheduled sync. Machine-specific, rewritten on every run,
# and it was carrying this machine's absolute paths and permission errors into
# the repo for anyone who cloned it.
data/auto_sync.log
# Runtime logs from the health-check job and the daily sync driver. Same
# reason as above: machine-specific, rewritten on every run.
data/health_check.log
data/.health_check_strikes
sync.log
